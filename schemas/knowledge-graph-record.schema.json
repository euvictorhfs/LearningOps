{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningops.local/schemas/knowledge-graph-record.schema.json",
  "title": "LearningOps Knowledge Graph Record",
  "oneOf": [
    {
      "title": "Node",
      "type": "object",
      "required": ["record_type", "id", "node_type", "label"],
      "properties": {
        "record_type": {"const": "node"},
        "id": {"type": "string", "minLength": 1},
        "node_type": {"enum": ["area", "domain", "subdomain", "concept", "mechanism", "pattern", "architecture", "technology", "failure_mode", "tradeoff", "competency"]},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "additionalProperties": true
    },
    {
      "title": "Edge",
      "type": "object",
      "required": ["record_type", "id", "from", "to", "relation"],
      "properties": {
        "record_type": {"const": "edge"},
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "relation": {"enum": ["requires", "part_of", "implements", "uses", "contrasts_with", "enables", "constrains", "fails_when", "optimized_by", "example_of", "alternative_to", "evolves_into"]},
        "rationale": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "additionalProperties": true
    }
  ]
}
